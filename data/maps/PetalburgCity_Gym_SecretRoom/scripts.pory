raw`PetalburgCity_Gym_SecretRoom_MapScripts::
	.byte 0
`
mapscripts PetalburgCity_Gym_SecretRoom {}

script PetalburgCity_Gym_AccuracyRoomEventScript_IgglybuffBall{
 
    lockall
    showmonpic(SPECIES_IGGLYBUFF, 10,3)
    msgbox("Do you want to choose IGGLYBUFF?\pThis Pokemon was trained to never\nmiss a move.", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_PIKACHU_STARTER, 5, ITEM_WIDE_LENS)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved the IGGLYBUFF!")
			removeobject(1)
			removeobject(2)
            setflag(FLAG_PETALBURG_ACCURACY_1)
			setflag(FLAG_PETALBURG_ACCURACY_2)
            setflag(FLAG_PETALBURG_RECEIVED_POKEMON)
            call(NicknamePartyMon3)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved the IGGLYBUFF!")
			removeobject(1)
			removeobject(2)
            setflag(FLAG_PETALBURG_ACCURACY_1)
			setflag(FLAG_PETALBURG_ACCURACY_2)
            setflag(FLAG_PETALBURG_RECEIVED_POKEMON)
            call(NicknameBoxMon3)
        }
        else{
            hidemonpic
            msgbox("No more room!")
        }
    }
    else{
        hidemonpic
        msgbox(PetalburgCity_Gym_Pokemon_NotChosen)
    }
    waitmessage
    releaseall
    end
 }

