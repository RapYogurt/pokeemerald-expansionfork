script NicknamePartyMon3{
 
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
 
 
}
 
script NicknameBoxMon3{
 
    msgbox("Give it a nickname?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_NameReceivedBoxMon)
    }
    call(Common_EventScript_TransferredToPC)
 
}
 
text PetalburgCity_Gym_Pokemon_NotChosen{
    "Better to leave it where it is."
}

script PetalburgCityGym_SecretRoom_EnterSecretRoom{
 
    msgbox("A chill runs down your spine.\nYou feel like you shouldn't be here.\pYou know that if you steal a POKÉMON,\nboth rooms will lock when you leave.")
    setvar (VAR_PETALBURG_SECRET_ROOM_ENTERED, 1)
    waitmessage
    releaseall
    end

}
